---
layout: base.njk
---

<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
    {% if tags %}
    <div class="tags">
      {% for tag in tags %}
        {% if tag != "posts" %}
        <span class="tag">{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </header>
  
  <div class="post-content">
    {{ content | safe }}
  </div>
</article>

<nav class="post-nav">
  <a href="/blog/">← Back to all posts</a>
</nav>
