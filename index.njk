---
layout: base.njk
title: Home
---

<section class="hero">
  <div class="hero-logo-wrap">
    <img src="/assets/img/logo3_clean.png" alt="zlarsen.cloud" class="hero-logo" width="220" height="220">
  </div>
  <p class="hero-tagline">Azure &middot; Architecture &middot; Learning</p>
  <p class="hero-subtitle">Cloud Solution Architect sharing practical guides on Azure infrastructure, AI, networking, security, and FinOps.</p>
  <div class="hero-actions">
    <a href="/blog/" class="btn btn-primary">Explore Azure</a>
    <a href="/about/" class="btn btn-outline">About Me</a>
  </div>
</section>

<section class="section">
  <div class="home-layout">
    <div class="home-posts">
      <h2 class="section-title">Recent Posts</h2>
      <div class="post-grid" id="home-post-grid">
        {%- for post in collections.posts | reverse -%}
          {%- if post.data.pinned -%}
        <article class="post-card post-card--pinned">
          <div class="post-card-body">
            <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">
              <span class="pin-badge" aria-label="Pinned post">📌 Pinned</span>
              {{ post.date | readableDate }}
            </time>
            <span class="post-card-reading-time">{{ post.templateContent | readingTime }}</span>
            <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            {% if post.data.excerpt %}
            <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
            {% endif %}
            {% if post.data.tags %}
            <div class="post-card-tags">
              {% for tag in post.data.tags %}
                {% if tag != "posts" %}
                <span class="tag">{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
          <a href="{{ post.url }}" class="post-card-link" aria-label="Read {{ post.data.title }}"></a>
        </article>
          {%- endif -%}
        {%- endfor -%}
        {%- for post in collections.posts | reverse -%}
          {%- if not post.data.pinned -%}
        <article class="post-card{% if post.data.tool %} post-card--tool{% endif %}">
          <div class="post-card-body">
            <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">
              {% if post.data.tool %}<span class="tool-badge" aria-label="Tool">🛠️ Tool</span>{% endif %}
              {{ post.date | readableDate }}
            </time>
            <span class="post-card-reading-time">{{ post.templateContent | readingTime }}</span>
            <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            {% if post.data.excerpt %}
            <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
            {% endif %}
            {% if post.data.tags %}
            <div class="post-card-tags">
              {% for tag in post.data.tags %}
                {% if tag != "posts" %}
                <span class="tag">{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
          <a href="{{ post.url }}" class="post-card-link" aria-label="Read {{ post.data.title }}"></a>
        </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <aside class="home-sidebar">
      <p class="home-sidebar-title">Browse by Tag</p>
      <div id="home-tag-cloud" class="home-tag-cloud"></div>
    </aside>
  </div>
</section>

<script>
(function () {
  var cards = Array.from(document.querySelectorAll('#home-post-grid .post-card'));
  var cloud = document.getElementById('home-tag-cloud');
  if (!cloud) return;

  var tagSet = new Set();
  cards.forEach(function (card) {
    card.querySelectorAll('.tag').forEach(function (el) {
      tagSet.add(el.textContent.trim().toLowerCase());
    });
  });

  Array.from(tagSet).sort(function (a, b) {
    return a.localeCompare(b);
  }).forEach(function (tag) {
    var a = document.createElement('a');
    a.className = 'home-tag-btn';
    a.textContent = tag;
    a.href = '/blog/?tag=' + encodeURIComponent(tag);
    cloud.appendChild(a);
  });
})();
</script>
