---
layout: base.njk
title: Blog
---

<section class="section">
  <h1 class="section-title">All Posts</h1>
  <div class="post-grid">
    {%- for post in collections.posts | reverse -%}
      {%- if post.data.pinned -%}
    <article class="post-card post-card--pinned">
      <div class="post-card-body">
        <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">
          <span class="pin-badge" aria-label="Pinned post">📌 Pinned</span>
          {{ post.date | readableDate }}
        </time>
        <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        {% if post.data.excerpt %}
        <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
        {% endif %}
        {% if post.data.tags %}
        <div class="post-card-tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" %}
            <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <a href="{{ post.url }}" class="post-card-link" aria-label="Read {{ post.data.title }}"></a>
    </article>
      {%- endif -%}
    {%- endfor -%}
    {%- for post in collections.posts | reverse -%}
      {%- if not post.data.pinned -%}
    <article class="post-card">
      <div class="post-card-body">
        <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
        <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        {% if post.data.excerpt %}
        <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
        {% endif %}
        {% if post.data.tags %}
        <div class="post-card-tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" %}
            <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <a href="{{ post.url }}" class="post-card-link" aria-label="Read {{ post.data.title }}"></a>
    </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
