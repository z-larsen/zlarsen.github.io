---
layout: base.njk
title: Blog
---

<section class="section">
  <div class="section-header">
    <h1 class="section-title">All Posts</h1>
    <span id="post-count" class="post-count"></span>
  </div>
  <div id="tag-filters" class="tag-filter-bar"></div>
  <div class="post-grid">
    {%- for post in collections.posts | reverse -%}
      {%- if post.data.pinned -%}
    <article class="post-card post-card--pinned">
      <div class="post-card-body">
        <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">
          <span class="pin-badge" aria-label="Pinned post">📌 Pinned</span>
          {{ post.date | readableDate }}
        </time>
        <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        {% if post.data.excerpt %}
        <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
        {% endif %}
        {% if post.data.tags %}
        <div class="post-card-tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" %}
            <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <a href="{{ post.url }}" class="post-card-link" aria-label="Read {{ post.data.title }}"></a>
    </article>
      {%- endif -%}
    {%- endfor -%}
    {%- for post in collections.posts | reverse -%}
      {%- if not post.data.pinned -%}
    <article class="post-card{% if post.data.tool %} post-card--tool{% endif %}">
      <div class="post-card-body">
        <time class="post-card-date" datetime="{{ post.date | htmlDateString }}">
          {% if post.data.tool %}<span class="tool-badge" aria-label="Tool">🛠️ Tool</span>{% endif %}
          {{ post.date | readableDate }}
        </time>
        <h3 class="post-card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        {% if post.data.excerpt %}
        <p class="post-card-excerpt">{{ post.data.excerpt }}</p>
        {% endif %}
        {% if post.data.tags %}
        <div class="post-card-tags">
          {% for tag in post.data.tags %}
            {% if tag != "posts" %}
            <span class="tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <a href="{{ post.url }}" class="post-card-link" aria-label="Read {{ post.data.title }}"></a>
    </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script>
(function () {
  const cards = Array.from(document.querySelectorAll('.post-card'));
  const bar = document.getElementById('tag-filters');
  const countEl = document.getElementById('post-count');

  // Collect unique tags from rendered .tag spans (normalized to lowercase)
  const tagSet = new Set();
  cards.forEach(function (card) {
    card.querySelectorAll('.tag').forEach(function (el) {
      tagSet.add(el.textContent.trim().toLowerCase());
    });
  });

  const allTags = Array.from(tagSet).sort(function (a, b) {
    return a.localeCompare(b);
  });

  function updateCount(visible) {
    if (countEl) {
      countEl.textContent = visible + ' of ' + cards.length + ' post' + (cards.length !== 1 ? 's' : '');
    }
  }

  if (!bar || allTags.length === 0) {
    updateCount(cards.length);
    return;
  }

  // Build "All" button
  var allBtn = document.createElement('button');
  allBtn.className = 'tag-filter-btn tag-filter-btn--active';
  allBtn.textContent = 'All';
  allBtn.dataset.tag = '';
  bar.appendChild(allBtn);

  // Build one button per tag
  allTags.forEach(function (tag) {
    var btn = document.createElement('button');
    btn.className = 'tag-filter-btn';
    btn.textContent = tag;
    btn.dataset.tag = tag;
    bar.appendChild(btn);
  });

  updateCount(cards.length);

  var activeTag = '';

  // Pre-select tag from ?tag= URL param (e.g. linked from home page)
  var urlParams = new URLSearchParams(window.location.search);
  var paramTag = urlParams.get('tag');
  if (paramTag) {
    var matchBtn = bar.querySelector('[data-tag="' + paramTag.toLowerCase() + '"]');
    if (matchBtn) {
      matchBtn.click();
    }
  }

  bar.addEventListener('click', function (e) {
    var btn = e.target.closest('.tag-filter-btn');
    if (!btn) return;

    var tag = btn.dataset.tag;

    // Clicking the active filter again resets to All
    activeTag = (activeTag === tag) ? '' : tag;

    // Update button active states
    bar.querySelectorAll('.tag-filter-btn').forEach(function (b) {
      var isActive = (activeTag === '' && b.dataset.tag === '') || (b.dataset.tag === activeTag);
      b.classList.toggle('tag-filter-btn--active', isActive);
    });

    // Filter cards
    var visible = 0;
    cards.forEach(function (card) {
      if (!activeTag) {
        card.style.display = '';
        visible++;
        return;
      }
      var cardTags = Array.from(card.querySelectorAll('.tag')).map(function (el) {
        return el.textContent.trim().toLowerCase();
      });
      var show = cardTags.includes(activeTag);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    updateCount(visible);
  });
})();
</script>
